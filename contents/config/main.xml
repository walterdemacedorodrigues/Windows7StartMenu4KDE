<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">
    <entry name="displayPosition" type="Enum">
    <label>Where the menu is placed when it opens.</label>
    <choices name="Settings::displayPosition">
      <choice name="Default" />
      <choice name="Center" />
      <choice name="CenterBottom" />
    </choices>
    <default>Default</default>
    </entry>

    <entry name="icon" type="String">
      <default>start-here-kde</default>
    </entry>
    <entry name="useCustomButtonImage" type="Bool">
      <default>false</default>
    </entry>
    <entry name="customButtonImage" type="Url">
      <default></default>
    </entry>

    <entry name="useWindowsOrb" type="Bool">
      <label>Draw the panel button as a Windows style orb instead of a system icon.</label>
      <default>false</default>
    </entry>
    <entry name="orbImage" type="Url">
      <label>ClassicShell/OpenShell compatible three frame PNG used for the orb.</label>
      <default></default>
    </entry>
    <entry name="orbWidth" type="Int">
      <label>Orb width in pixels, 0 means the texture's own width.</label>
      <default>0</default>
      <min>0</min>
    </entry>
    <entry name="useWindowsIcons" type="Bool">
      <label>Prefer Windows style icon names for the side panel, falling back to system icons.</label>
      <default>false</default>
    </entry>
    <entry name="useGenericIcons" type="Bool">
      <label>Draw application categories with a plain folder icon.</label>
      <default>false</default>
    </entry>

    <entry name="hierarchicalAllPrograms" type="Bool">
      <label>Browse All Programs as an expandable category tree.</label>
      <default>true</default>
    </entry>
    <entry name="highlightNewApps" type="Bool">
      <default>true</default>
    </entry>
    <entry name="switchCategoriesOnHover" type="Bool">
      <label>Whether to switch between menu categories by hovering them.</label>
      <default>true</default>
    </entry>

    <entry name="showRecentsView" type="Bool">
      <default>true</default>
    </entry>
    <entry name="numberRecentApps" type="Int">
      <label>How many recently used applications the left column renders.</label>
      <default>10</default>
      <min>0</min>
      <max>20</max>
    </entry>
    <entry name="numberRecentFiles" type="Int">
      <label>How many recent documents each jump list renders.</label>
      <default>10</default>
      <min>1</min>
      <max>30</max>
    </entry>
    <entry name="recentOrdering" type="Int">
      <default>0</default>
    </entry>

    <entry name="sidePanelVisibility" type="String">
      <label>JSON object naming which side panel entries are shown.</label>
      <default>{"Home directory":1,"Documents":1,"Pictures":1,"Music":1,"Videos":1,"Downloads":1,"Recent Items":1,"Computer":1,"Network":1,"Control Panel":1,"Default Programs":1,"Run":1}</default>
    </entry>
    <entry name="submenuHoverDelay" type="Int">
      <label>Milliseconds a side panel entry must be hovered before its flyout opens.</label>
      <default>400</default>
      <min>0</min>
      <max>2000</max>
    </entry>
    <entry name="useFullName" type="Bool">
      <label>Label the home entry with the full name instead of the login name.</label>
      <default>false</default>
    </entry>

    <entry name="menuFrameUseThemeColor" type="Bool">
      <label>Tint the whole menu with the theme background colour.</label>
      <default>true</default>
    </entry>
    <entry name="menuFrameColor" type="Color">
      <default>#31363b</default>
    </entry>
    <entry name="menuFrameOpacity" type="Int">
      <label>Opacity of the tint painted over the whole menu, 0 leaves the theme alone.</label>
      <default>0</default>
      <min>0</min>
      <max>100</max>
    </entry>

    <entry name="listPanelUseThemeColor" type="Bool">
      <default>true</default>
    </entry>
    <entry name="listPanelColor" type="Color">
      <default>#31363b</default>
    </entry>
    <entry name="listPanelOpacity" type="Int">
      <label>Opacity of the tint painted behind the application list, 0 leaves the theme alone.</label>
      <default>0</default>
      <min>0</min>
      <max>100</max>
    </entry>

    <entry name="sidePanelUseThemeColor" type="Bool">
      <default>true</default>
    </entry>
    <entry name="sidePanelColor" type="Color">
      <default>#31363b</default>
    </entry>
    <entry name="sidePanelOpacity" type="Int">
      <label>Opacity of the tint painted behind the side panel, 0 leaves the theme alone.</label>
      <default>0</default>
      <min>0</min>
      <max>100</max>
    </entry>

    <entry name="showFilterList" type="Bool">
      <default>true</default>
    </entry>
    <entry name="appNameFormat" type="Int">
      <default>0</default>
    </entry>
    <entry name="limitDepth" type="Bool">
      <default>false</default>
    </entry>
    <entry name="numberColumns" type="Int">
      <default>6</default>
    </entry>
    <entry name="numberRows" type="Int">
      <default>4</default>
    </entry>

    <entry name="favoriteApps" type="StringList">
      <default>preferred://browser,org.kde.dolphin.desktop</default>
    </entry>
    <entry name="favoriteSystemActions" type="StringList">
         <label>List of system action favorites.</label>
         <default>lock-screen,logout,switch-user,suspend,hibernate,reboot,shutdown</default>
    </entry>
    <entry name="hiddenApplications" type="StringList">
      <default></default>
    </entry>

    <entry name="useExtraRunners" type="Bool">
      <default>true</default>
    </entry>
    <entry name="labels2lines" type="Bool">
      <default>true</default>
    </entry>
    <entry name="extraRunners" type="StringList">
      <default>bookmarks,baloosearch</default>
    </entry>
    <entry name="alignResultsToBottom" type="Bool">
      <default>true</default>
    </entry>

    <entry name="removeApplicationCommand" type="String">
      <default>muon-discover --application</default>
    </entry>
    <entry name="showAtCenter" type="Bool">
       <default>true</default>
    </entry>
    <entry name="showFavoritesFirst" type="Bool">
       <default>false</default>
    </entry>
    <entry name="favoritesPortedToKAstats" type="Bool">
      <label>Are the favorites ported to use KActivitiesStats to allow per-activity favorites</label>
      <default>false</default>
    </entry>
    <entry name="viewUser" type="Bool">
      <default>true</default>
    </entry>
  </group>
</kcfg>
