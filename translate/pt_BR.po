msgid "User Settings"
msgstr "Configurações do Usuário"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "Click to open user account settings"
msgstr "Clique para abrir as configurações da conta de usuário"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Restart"
msgstr "Reiniciar"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Turn Off Screen"
