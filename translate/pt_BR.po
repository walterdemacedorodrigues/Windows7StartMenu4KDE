msgid "Closes all open programs, shuts down the system and turns off your computer."
msgstr "Fecha todos os programas abertos, encerra o sistema e desliga o computador."

#: ../contents/ui/SidePanelModels.qml
msgid "Open your personal folder."
msgstr "Abra sua pasta pessoal."

#: ../contents/ui/SidePanelModels.qml
msgid "Documents"
msgstr "Documentos"

#: ../contents/ui/SidePanelModels.qml
msgid "Access letters, reports, notes and other kinds of documents."
msgstr "Acesse cartas, relatórios, anotações e outros tipos de documentos."

#: ../contents/ui/SidePanelModels.qml
msgid "Pictures"
msgstr "Imagens"

#: ../contents/ui/SidePanelModels.qml
msgid "View and organize digital pictures."
msgstr "Exiba e organize imagens digitais."

#: ../contents/ui/SidePanelModels.qml
msgid "Music"
msgstr "Música"

#: ../contents/ui/SidePanelModels.qml
msgid "Play music and other audio files."
msgstr "Reproduza músicas e outros arquivos de áudio."

#: ../contents/ui/SidePanelModels.qml
msgid "Videos"
msgstr "Vídeos"

#: ../contents/ui/SidePanelModels.qml
msgid "Watch home movies and other digital videos."
msgstr "Assista a filmes caseiros e outros vídeos digitais."

#: ../contents/ui/SidePanelModels.qml
msgid "Downloads"
msgstr "Downloads"

#: ../contents/ui/SidePanelModels.qml
msgid "Find Internet downloads and links to favorite websites."
msgstr "Encontre downloads da Internet e links para sites favoritos."

#: ../contents/ui/SidePanelModels.qml
msgid "Games"
msgstr "Jogos"

#: ../contents/ui/SidePanelModels.qml
msgid "Play and manage games on your computer."
msgstr "Jogue e gerencie jogos no computador."

#: ../contents/ui/SidePanelModels.qml
msgid "Recent Items"
msgstr "Itens Recentes"

#: ../contents/ui/SidePanelModels.qml
msgid "Open documents you worked on recently."
msgstr "Abra documentos com os quais você trabalhou recentemente."

#: ../contents/ui/SidePanelModels.qml
msgid "Computer"
msgstr "Computador"

#: ../contents/ui/SidePanelModels.qml
msgid "See the disk drives and other hardware connected to your computer."
msgstr "Veja as unidades de disco e outros dispositivos conectados ao computador."

#: ../contents/ui/SidePanelModels.qml
msgid "Network"
msgstr "Rede"

#: ../contents/ui/SidePanelModels.qml
msgid "Access the computers and devices that are on your network."
msgstr "Acesse os computadores e dispositivos que estão na sua rede."

#: ../contents/ui/SidePanelModels.qml
msgid "Control Panel"
msgstr "Painel de Controle"

#: ../contents/ui/SidePanelModels.qml
msgid "Change settings and customize the functionality of your computer."
msgstr "Altere as configurações e personalize a funcionalidade do computador."

#: ../contents/ui/SidePanelModels.qml
msgid "Devices and Printers"
msgstr "Dispositivos e Impressoras"

