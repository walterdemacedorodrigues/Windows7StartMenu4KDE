msgid "Hibernate"
msgstr "Hibernar"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Log Out"
msgstr "Encerrar sessão"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Shutdown"
msgstr "Desligar"

