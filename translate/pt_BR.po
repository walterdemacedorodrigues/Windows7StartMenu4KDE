msgid "View and manage devices, printers and print jobs."
msgstr "Exiba e gerencie dispositivos, impressoras e trabalhos de impressão."

#: ../contents/ui/SidePanelModels.qml
msgid "Default Programs"
msgstr "Programas Padrão"

#: ../contents/ui/SidePanelModels.qml
msgid "Choose default programs for web browsing, e-mail and other activities."
msgstr "Escolha os programas padrão para navegação na Web, email e outras atividades."

#: ../contents/ui/SidePanelModels.qml
msgid "Help and Support"
msgstr "Ajuda e Suporte"

#: ../contents/ui/SidePanelModels.qml
msgid "Find help topics, tutorials, troubleshooting and other support services."
msgstr "Localize tópicos da Ajuda, tutoriais, solução de problemas e outros serviços de suporte."

#: ../contents/ui/SidePanelModels.qml
msgid "Run…"
msgstr "Executar…"

#: ../contents/ui/SidePanelModels.qml
msgid "Open a program, folder, document or web site."
msgstr "Abra um programa, pasta, documento ou site."
