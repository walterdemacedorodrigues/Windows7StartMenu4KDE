msgid "PNG images (*.png)"
msgstr "Images PNG (*.png)"

#: ../contents/ui/OrbPicker.qml
msgid "ClassicShell and OpenShell orb textures are supported. The image must stack the normal, hovered and pressed frames vertically."
msgstr "Les textures d'orbe de ClassicShell et d'OpenShell sont prises en charge. L'image doit empiler verticalement les états normal, survolé et enfoncé."

#: ../contents/ui/OrbPicker.qml
msgctxt "@item:inmenu Open file chooser dialog"
msgid "Choose…"
msgstr "Choisir…"

#: ../contents/ui/OrbPicker.qml
msgctxt "@item:inmenu Reset to the bundled orb"
msgid "Reset"
msgstr "Réinitialiser"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "User Settings"
msgstr "Paramètres de l'utilisateur"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "Click to open user account settings"
msgstr "Cliquez pour ouvrir les paramètres du compte utilisateur"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Restart"
msgstr "Redémarrer"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Turn Off Screen"
msgstr "Éteindre l'écran"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Lock Screen"
msgstr "Verrouiller l'écran"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Sleep"
msgstr "Mettre en veille"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Hibernate"
msgstr "Hiberner"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Log Out"
msgstr "Se déconnecter"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Shutdown"
msgstr "Arrêter"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Closes all open programs, shuts down the system and turns off your computer."
msgstr "Ferme tous les programmes ouverts, arrête le système et éteint votre ordinateur."

#: ../contents/ui/SidePanelModels.qml
msgid "Open your personal folder."
msgstr "Ouvre votre dossier personnel."

#: ../contents/ui/SidePanelModels.qml
msgid "Documents"
msgstr "Documents"

#: ../contents/ui/SidePanelModels.qml
msgid "Access letters, reports, notes and other kinds of documents."
msgstr "Accédez aux lettres, rapports, notes et autres types de documents."

#: ../contents/ui/SidePanelModels.qml
msgid "Pictures"
msgstr "Images"

#: ../contents/ui/SidePanelModels.qml
msgid "View and organize digital pictures."
msgstr "Affichez et organisez vos images numériques."

#: ../contents/ui/SidePanelModels.qml
msgid "Music"
msgstr "Musique"

#: ../contents/ui/SidePanelModels.qml
msgid "Play music and other audio files."
msgstr "Écoutez de la musique et d'autres fichiers audio."

#: ../contents/ui/SidePanelModels.qml
msgid "Videos"
msgstr "Vidéos"

#: ../contents/ui/SidePanelModels.qml
msgid "Watch home movies and other digital videos."
msgstr "Regardez vos films personnels et d'autres vidéos numériques."

#: ../contents/ui/SidePanelModels.qml
msgid "Downloads"
msgstr "Téléchargements"

#: ../contents/ui/SidePanelModels.qml
msgid "Find Internet downloads and links to favorite websites."
msgstr "Retrouvez vos téléchargements et les liens vers vos sites web favoris."

#: ../contents/ui/SidePanelModels.qml
msgid "Games"
msgstr "Jeux"

#: ../contents/ui/SidePanelModels.qml
msgid "Play and manage games on your computer."
msgstr "Jouez et gérez les jeux de votre ordinateur."

#: ../contents/ui/SidePanelModels.qml
msgid "Recent Items"
msgstr "Éléments récents"

#: ../contents/ui/SidePanelModels.qml
msgid "Open documents you worked on recently."
msgstr "Ouvrez les documents sur lesquels vous avez travaillé récemment."

#: ../contents/ui/SidePanelModels.qml
msgid "Computer"
msgstr "Ordinateur"

#: ../contents/ui/SidePanelModels.qml
msgid "See the disk drives and other hardware connected to your computer."
msgstr "Consultez les lecteurs de disque et les autres matériels connectés à votre ordinateur."

#: ../contents/ui/SidePanelModels.qml
msgid "Network"
msgstr "Réseau"

#: ../contents/ui/SidePanelModels.qml
msgid "Access the computers and devices that are on your network."
msgstr "Accédez aux ordinateurs et aux périphériques présents sur votre réseau."

#: ../contents/ui/SidePanelModels.qml
msgid "Control Panel"
msgstr "Panneau de configuration"

#: ../contents/ui/SidePanelModels.qml
msgid "Change settings and customize the functionality of your computer."
msgstr "Modifiez les paramètres et personnalisez le fonctionnement de votre ordinateur."

#: ../contents/ui/SidePanelModels.qml
msgid "Devices and Printers"
msgstr "Périphériques et imprimantes"

#: ../contents/ui/SidePanelModels.qml
msgid "View and manage devices, printers and print jobs."
msgstr "Affichez et gérez les périphériques, les imprimantes et les tâches d'impression."

#: ../contents/ui/SidePanelModels.qml
msgid "Default Programs"
msgstr "Programmes par défaut"

#: ../contents/ui/SidePanelModels.qml
msgid "Choose default programs for web browsing, e-mail and other activities."
msgstr "Choisissez les programmes par défaut pour la navigation web, la messagerie et d'autres activités."

#: ../contents/ui/SidePanelModels.qml
msgid "Help and Support"
msgstr "Aide et support"

#: ../contents/ui/SidePanelModels.qml
msgid "Find help topics, tutorials, troubleshooting and other support services."
msgstr "Trouvez des rubriques d'aide, des didacticiels, des dépannages et d'autres services d'assistance."

#: ../contents/ui/SidePanelModels.qml
msgid "Run…"
msgstr "Exécuter…"

#: ../contents/ui/SidePanelModels.qml
msgid "Open a program, folder, document or web site."
msgstr "Ouvrez un programme, un dossier, un document ou un site web."
