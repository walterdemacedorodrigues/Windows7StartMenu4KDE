msgid "ClassicShell and OpenShell orb textures are supported. The image must stack the normal, hovered and pressed frames vertically."
msgstr "Поддерживаются текстуры сферы из ClassicShell и OpenShell. Изображение должно содержать расположенные по вертикали кадры обычного состояния, наведения и нажатия."

#: ../contents/ui/OrbPicker.qml
msgctxt "@item:inmenu Open file chooser dialog"
msgid "Choose…"
msgstr "Выбрать…"

#: ../contents/ui/OrbPicker.qml
msgctxt "@item:inmenu Reset to the bundled orb"
msgid "Reset"
msgstr "Сбросить"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "User Settings"
msgstr "Параметры пользователя"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "Click to open user account settings"
msgstr "Нажмите, чтобы открыть параметры учётной записи"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Restart"
msgstr "Перезагрузить"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Turn Off Screen"
msgstr "Выключить экран"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Lock Screen"
msgstr "Заблокировать"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Sleep"
msgstr "Ждущий режим"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Hibernate"
msgstr "Спящий режим"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Log Out"
msgstr "Выйти из системы"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Shutdown"
msgstr "Выключить"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Closes all open programs, shuts down the system and turns off your computer."
msgstr "Закрывает все открытые программы, завершает работу системы и выключает питание компьютера."

#: ../contents/ui/SidePanelModels.qml
msgid "Open your personal folder."
msgstr "Открыть вашу личную папку."

#: ../contents/ui/SidePanelModels.qml
msgid "Documents"
msgstr "Документы"

#: ../contents/ui/SidePanelModels.qml
msgid "Access letters, reports, notes and other kinds of documents."
msgstr "Доступ к письмам, отчётам, заметкам и другим документам."

#: ../contents/ui/SidePanelModels.qml
msgid "Pictures"
msgstr "Изображения"

#: ../contents/ui/SidePanelModels.qml
msgid "View and organize digital pictures."
msgstr "Просмотр и упорядочивание цифровых изображений."

#: ../contents/ui/SidePanelModels.qml
msgid "Music"
msgstr "Музыка"

#: ../contents/ui/SidePanelModels.qml
msgid "Play music and other audio files."
msgstr "Воспроизведение музыки и других звуковых файлов."

#: ../contents/ui/SidePanelModels.qml
msgid "Videos"
msgstr "Видео"

#: ../contents/ui/SidePanelModels.qml
msgid "Watch home movies and other digital videos."
msgstr "Просмотр домашнего видео и других цифровых записей."

#: ../contents/ui/SidePanelModels.qml
msgid "Downloads"
msgstr "Загрузки"

#: ../contents/ui/SidePanelModels.qml
msgid "Find Internet downloads and links to favorite websites."
msgstr "Поиск загрузок из Интернета и ссылок на избранные сайты."

#: ../contents/ui/SidePanelModels.qml
msgid "Games"
msgstr "Игры"

#: ../contents/ui/SidePanelModels.qml
msgid "Play and manage games on your computer."
msgstr "Игры на вашем компьютере и управление ими."

#: ../contents/ui/SidePanelModels.qml
msgid "Recent Items"
msgstr "Недавние документы"

#: ../contents/ui/SidePanelModels.qml
msgid "Open documents you worked on recently."
msgstr "Открыть документы, с которыми вы недавно работали."

#: ../contents/ui/SidePanelModels.qml
msgid "Computer"
msgstr "Компьютер"

#: ../contents/ui/SidePanelModels.qml
msgid "See the disk drives and other hardware connected to your computer."
msgstr "Просмотр дисков и другого оборудования, подключённого к компьютеру."

#: ../contents/ui/SidePanelModels.qml
msgid "Network"
msgstr "Сеть"

#: ../contents/ui/SidePanelModels.qml
msgid "Access the computers and devices that are on your network."
msgstr "Доступ к компьютерам и устройствам в вашей сети."

#: ../contents/ui/SidePanelModels.qml
msgid "Control Panel"
msgstr "Панель управления"

#: ../contents/ui/SidePanelModels.qml
msgid "Change settings and customize the functionality of your computer."
msgstr "Изменение параметров и настройка работы компьютера."

#: ../contents/ui/SidePanelModels.qml
msgid "Devices and Printers"
msgstr "Устройства и принтеры"

#: ../contents/ui/SidePanelModels.qml
msgid "View and manage devices, printers and print jobs."
msgstr "Просмотр устройств, принтеров и заданий печати и управление ими."

#: ../contents/ui/SidePanelModels.qml
msgid "Default Programs"
msgstr "Программы по умолчанию"

#: ../contents/ui/SidePanelModels.qml
msgid "Choose default programs for web browsing, e-mail and other activities."
msgstr "Выбор программ по умолчанию для просмотра веб-страниц, электронной почты и других задач."

#: ../contents/ui/SidePanelModels.qml
msgid "Help and Support"
msgstr "Справка и поддержка"

#: ../contents/ui/SidePanelModels.qml
msgid "Find help topics, tutorials, troubleshooting and other support services."
msgstr "Поиск разделов справки, учебников, средств устранения неполадок и других служб поддержки."

#: ../contents/ui/SidePanelModels.qml
msgid "Run…"
msgstr "Выполнить…"

#: ../contents/ui/SidePanelModels.qml
msgid "Open a program, folder, document or web site."
msgstr "Открыть программу, папку, документ или веб-сайт."
