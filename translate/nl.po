#: ../contents/ui/ConfigGeneral.qml
msgid "System icon:"
msgstr "Systeempictogram:"

#: ../contents/ui/ConfigGeneral.qml
msgctxt "@item:inmenu Open icon chooser dialog"
msgid "Choose…"
msgstr "Kiezen…"

#: ../contents/ui/ConfigGeneral.qml
msgctxt "@item:inmenu Reset icon to default"
msgid "Clear Icon"
msgstr "Pictogram verwijderen"

#: ../contents/ui/ConfigGeneral.qml
msgid "Use the Windows orb instead of a system icon"
msgstr "De Windows-orb gebruiken in plaats van een systeempictogram"

#: ../contents/ui/ConfigGeneral.qml
msgid "Orb texture:"
msgstr "Orbtextuur:"

#: ../contents/ui/ConfigGeneral.qml
msgid "Orb width:"
msgstr "Orbbreedte:"

#: ../contents/ui/ConfigGeneral.qml
msgid "Texture size"
msgstr "Textuurgrootte"

#: ../contents/ui/ConfigGeneral.qml
msgid "Icons:"
msgstr "Pictogrammen:"

#: ../contents/ui/ConfigGeneral.qml
msgid "Prefer Windows style icons in the side panel"
msgstr "Pictogrammen in Windows-stijl gebruiken in het zijpaneel"

#: ../contents/ui/ConfigGeneral.qml
msgid "Draw application categories with a plain folder icon"
msgstr "Programmacategorieën met een gewoon mappictogram tonen"

#: ../contents/ui/ConfigGeneral.qml
msgid "All Programs:"
msgstr "Alle programma's:"

#: ../contents/ui/ConfigGeneral.qml
msgid "Browse categories as an expandable tree"
msgstr "Categorieën doorbladeren als een uitklapbare boomstructuur"

#: ../contents/ui/ConfigGeneral.qml
msgid "Highlight newly installed applications"
msgstr "Nieuw geïnstalleerde programma's markeren"

#: ../contents/ui/ConfigGeneral.qml
msgid "Show favorites before recently used applications"
msgstr "Favorieten vóór recent gebruikte programma's tonen"

#: ../contents/ui/ConfigGeneral.qml
msgid "Recents:"
msgstr "Recent gebruikt:"

#: ../contents/ui/ConfigGeneral.qml
msgid "Show recently used applications"
msgstr "Recent gebruikte programma's tonen"

#: ../contents/ui/ConfigGeneral.qml
msgid "Applications listed:"
msgstr "Aantal getoonde programma's:"

#: ../contents/ui/ConfigGeneral.qml
msgid "Documents per jump list:"
msgstr "Documenten per jumplist:"

#: ../contents/ui/ConfigGeneral.qml
msgid "Flyout hover delay:"
msgstr "Vertraging van het uitklapmenu:"

#: ../contents/ui/ConfigGeneral.qml
msgid "Label the home entry with the full user name"
msgstr "De persoonlijke ingang van de volledige gebruikersnaam voorzien"

#: ../contents/ui/ConfigGeneral.qml
msgid "Search bookmarks and files as well as applications"
msgstr "Naast programma's ook bladwijzers en bestanden doorzoeken"

#: ../contents/ui/ConfigGeneral.qml
msgid "Unhide all hidden applications"
msgstr "Alle verborgen programma's zichtbaar maken"

#: ../contents/ui/ConfigGeneral.qml
msgid "All applications are visible again."
msgstr "Alle programma's zijn weer zichtbaar."

#: ../contents/ui/ConfigSidepanel.qml
msgid "Places"
msgstr "Locaties"

#: ../contents/ui/ConfigSidepanel.qml
msgid "Libraries"
msgstr "Bibliotheken"

#: ../contents/ui/ConfigSidepanel.qml
msgid "System"
msgstr "Systeem"

#: ../contents/ui/functions/GetRecentFiles.qml
msgid "Recent Files"
msgstr "Recente bestanden"

#: ../contents/ui/functions/GetRecentFiles.qml
msgid "No recent items"
msgstr "Geen recente items"

#: ../contents/ui/main.qml
msgid "Edit Applications…"
msgstr "Programma's bewerken…"

#: ../contents/ui/main.qml
msgid "All Applications"
msgstr "Alle programma's"

#: ../contents/ui/main.qml
msgid "Favorites"
msgstr "Favorieten"

#: ../contents/ui/MenuContent.qml ../contents/ui/parts/SearchBar.qml
msgid "Type here to search…"
msgstr "Typ hier om te zoeken…"

#: ../contents/ui/OrbPicker.qml
msgid "PNG images (*.png)"
msgstr "PNG-afbeeldingen (*.png)"

#: ../contents/ui/OrbPicker.qml
msgid ""
"ClassicShell and OpenShell orb textures are supported. The image must stack "
"the normal, hovered and pressed frames vertically."
msgstr ""
"Orbtexturen van ClassicShell en OpenShell worden ondersteund. De afbeelding "
"moet de toestanden normaal, aangewezen en ingedrukt verticaal boven elkaar "
"bevatten."

#: ../contents/ui/OrbPicker.qml
msgctxt "@item:inmenu Open file chooser dialog"
msgid "Choose…"
msgstr "Kiezen…"

#: ../contents/ui/OrbPicker.qml
msgctxt "@item:inmenu Reset to the bundled orb"
msgid "Reset"
msgstr "Herstellen"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "User Settings"
msgstr "Gebruikersinstellingen"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "Click to open user account settings"
msgstr "Klik om de instellingen van het gebruikersaccount te openen"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Restart"
msgstr "Herstarten"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Turn Off Screen"
msgstr "Scherm uitschakelen"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Lock Screen"
msgstr "Scherm vergrendelen"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Sleep"
msgstr "Slaapstand"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Hibernate"
msgstr "Sluimerstand"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Log Out"
msgstr "Afmelden"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Shutdown"
msgstr "Afsluiten"

#: ../contents/ui/parts/PowerButtons.qml
msgid ""
"Closes all open programs, shuts down the system and turns off your computer."
msgstr ""
"Sluit alle geopende programma's af, sluit het systeem af en schakelt de "
"computer uit."

#: ../contents/ui/SidePanelModels.qml
msgid "Open your personal folder."
msgstr "Opent uw persoonlijke map."

#: ../contents/ui/SidePanelModels.qml
msgid "Documents"
msgstr "Documenten"

#: ../contents/ui/SidePanelModels.qml
msgid "Access letters, reports, notes and other kinds of documents."
msgstr "Open brieven, rapporten, notities en andere soorten documenten."

#: ../contents/ui/SidePanelModels.qml
msgid "Pictures"
msgstr "Afbeeldingen"

#: ../contents/ui/SidePanelModels.qml
msgid "View and organize digital pictures."
msgstr "Bekijk en orden digitale afbeeldingen."

#: ../contents/ui/SidePanelModels.qml
msgid "Music"
msgstr "Muziek"

#: ../contents/ui/SidePanelModels.qml
msgid "Play music and other audio files."
msgstr "Speel muziek en andere audiobestanden af."

#: ../contents/ui/SidePanelModels.qml
msgid "Videos"
msgstr "Video's"

#: ../contents/ui/SidePanelModels.qml
msgid "Watch home movies and other digital videos."
msgstr "Bekijk thuisfilms en andere digitale video's."

#: ../contents/ui/SidePanelModels.qml
msgid "Downloads"
msgstr "Downloads"

#: ../contents/ui/SidePanelModels.qml
msgid "Find Internet downloads and links to favorite websites."
msgstr "Vind downloads van internet en koppelingen naar favoriete websites."

#: ../contents/ui/SidePanelModels.qml
msgid "Games"
msgstr "Spellen"

#: ../contents/ui/SidePanelModels.qml
msgid "Play and manage games on your computer."
msgstr "Speel en beheer de spellen op uw computer."

#: ../contents/ui/SidePanelModels.qml
msgid "Recent Items"
msgstr "Recente items"

#: ../contents/ui/SidePanelModels.qml
msgid "Open documents you worked on recently."
msgstr "Open documenten waaraan u onlangs hebt gewerkt."

#: ../contents/ui/SidePanelModels.qml
msgid "Computer"
msgstr "Computer"

#: ../contents/ui/SidePanelModels.qml
msgid "See the disk drives and other hardware connected to your computer."
msgstr ""
"Bekijk de schijfstations en andere hardware die op uw computer is "
"aangesloten."

#: ../contents/ui/SidePanelModels.qml
msgid "Network"
msgstr "Netwerk"

#: ../contents/ui/SidePanelModels.qml
msgid "Access the computers and devices that are on your network."
msgstr "Krijg toegang tot de computers en apparaten in uw netwerk."

#: ../contents/ui/SidePanelModels.qml
msgid "Control Panel"
msgstr "Configuratiescherm"

#: ../contents/ui/SidePanelModels.qml
msgid "Change settings and customize the functionality of your computer."
msgstr "Wijzig instellingen en pas de werking van uw computer aan."

#: ../contents/ui/SidePanelModels.qml
msgid "Devices and Printers"
msgstr "Apparaten en printers"

#: ../contents/ui/SidePanelModels.qml
msgid "View and manage devices, printers and print jobs."
msgstr "Bekijk en beheer apparaten, printers en afdruktaken."

#: ../contents/ui/SidePanelModels.qml
msgid "Default Programs"
msgstr "Standaardprogramma's"

#: ../contents/ui/SidePanelModels.qml
msgid "Choose default programs for web browsing, e-mail and other activities."
msgstr ""
"Kies standaardprogramma's voor webbrowsen, e-mail en andere activiteiten."

#: ../contents/ui/SidePanelModels.qml
msgid "Help and Support"
msgstr "Help en ondersteuning"

#: ../contents/ui/SidePanelModels.qml
msgid ""
"Find help topics, tutorials, troubleshooting and other support services."
msgstr ""
"Vind Help-onderwerpen, zelfstudies, probleemoplossing en andere "
"ondersteuningsdiensten."

#: ../contents/ui/SidePanelModels.qml
msgid "Run…"
msgstr "Uitvoeren…"

#: ../contents/ui/SidePanelModels.qml
msgid "Open a program, folder, document or web site."
msgstr "Open een programma, map, document of website."
