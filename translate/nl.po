#: ../contents/ui/ConfigAppearance.qml
msgid ""
"A tint is painted over the theme background. At zero the theme is left "
"untouched, and at one hundred the area is solid."
msgstr ""
"Er wordt een tint over de achtergrond van het thema geschilderd. Bij nul "
"blijft het thema onaangeroerd, bij honderd is het gebied volledig dekkend."

#: ../contents/ui/ConfigAppearance.qml
msgid "Whole menu opacity:"
msgstr "Dekking van het hele menu:"

#: ../contents/ui/ConfigAppearance.qml
msgid "Theme default"
msgstr "Standaard van het thema"

#: ../contents/ui/ConfigAppearance.qml
msgid "Use the theme background colour"
msgstr "De achtergrondkleur van het thema gebruiken"

#: ../contents/ui/ConfigAppearance.qml
msgid "Menu colour:"
msgstr "Menukleur:"

#: ../contents/ui/ConfigAppearance.qml
msgid "Application list opacity:"
msgstr "Dekking van de programmalijst:"

#: ../contents/ui/ConfigAppearance.qml
msgid "Application list colour:"
msgstr "Kleur van de programmalijst:"

