msgstr "PNG görselleri (*.png)"

#: ../contents/ui/OrbPicker.qml
msgid "ClassicShell and OpenShell orb textures are supported. The image must stack the normal, hovered and pressed frames vertically."
msgstr "ClassicShell ve OpenShell küre dokuları desteklenir. Görsel; normal, üzerine gelinmiş ve basılmış kareleri dikey olarak içermelidir."

#: ../contents/ui/OrbPicker.qml
msgctxt "@item:inmenu Open file chooser dialog"
msgid "Choose…"
msgstr "Seç…"

#: ../contents/ui/OrbPicker.qml
msgctxt "@item:inmenu Reset to the bundled orb"
msgid "Reset"
msgstr "Sıfırla"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "User Settings"
msgstr "Kullanıcı Ayarları"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "Click to open user account settings"
msgstr "Kullanıcı hesabı ayarlarını açmak için tıklayın"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Restart"
msgstr "Yeniden Başlat"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Turn Off Screen"
msgstr "Ekranı Kapat"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Lock Screen"
msgstr "Ekranı Kilitle"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Sleep"
msgstr "Uyku"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Hibernate"
msgstr "Hazırda Beklet"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Log Out"
msgstr "Oturumu Kapat"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Shutdown"
msgstr "Bilgisayarı Kapat"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Closes all open programs, shuts down the system and turns off your computer."
msgstr "Açık tüm programları kapatır, sistemi kapatır ve bilgisayarınızın gücünü keser."

#: ../contents/ui/SidePanelModels.qml
msgid "Open your personal folder."
msgstr "Kişisel klasörünüzü açar."

#: ../contents/ui/SidePanelModels.qml
msgid "Documents"
msgstr "Belgeler"

#: ../contents/ui/SidePanelModels.qml
msgid "Access letters, reports, notes and other kinds of documents."
msgstr "Mektuplara, raporlara, notlara ve diğer belge türlerine erişin."

#: ../contents/ui/SidePanelModels.qml
msgid "Pictures"
msgstr "Resimler"

#: ../contents/ui/SidePanelModels.qml
msgid "View and organize digital pictures."
msgstr "Dijital resimleri görüntüleyin ve düzenleyin."

#: ../contents/ui/SidePanelModels.qml
msgid "Music"
msgstr "Müzik"

#: ../contents/ui/SidePanelModels.qml
msgid "Play music and other audio files."
msgstr "Müzik ve diğer ses dosyalarını çalın."

#: ../contents/ui/SidePanelModels.qml
msgid "Videos"
msgstr "Videolar"

#: ../contents/ui/SidePanelModels.qml
msgid "Watch home movies and other digital videos."
msgstr "Ev videolarınızı ve diğer dijital videoları izleyin."

#: ../contents/ui/SidePanelModels.qml
msgid "Downloads"
msgstr "İndirilenler"

#: ../contents/ui/SidePanelModels.qml
msgid "Find Internet downloads and links to favorite websites."
msgstr "İnternetten indirdiklerinizi ve favori web sitelerine bağlantıları bulun."

#: ../contents/ui/SidePanelModels.qml
msgid "Games"
msgstr "Oyunlar"

#: ../contents/ui/SidePanelModels.qml
msgid "Play and manage games on your computer."
msgstr "Bilgisayarınızdaki oyunları oynayın ve yönetin."

#: ../contents/ui/SidePanelModels.qml
msgid "Recent Items"
msgstr "Son Ögeler"

#: ../contents/ui/SidePanelModels.qml
msgid "Open documents you worked on recently."
msgstr "Son zamanlarda üzerinde çalıştığınız belgeleri açın."

#: ../contents/ui/SidePanelModels.qml
msgid "Computer"
msgstr "Bilgisayar"

#: ../contents/ui/SidePanelModels.qml
msgid "See the disk drives and other hardware connected to your computer."
msgstr "Bilgisayarınıza bağlı disk sürücülerini ve diğer donanımları görün."

#: ../contents/ui/SidePanelModels.qml
msgid "Network"
msgstr "Ağ"

#: ../contents/ui/SidePanelModels.qml
msgid "Access the computers and devices that are on your network."
msgstr "Ağınızdaki bilgisayarlara ve aygıtlara erişin."

#: ../contents/ui/SidePanelModels.qml
msgid "Control Panel"
msgstr "Denetim Masası"

#: ../contents/ui/SidePanelModels.qml
msgid "Change settings and customize the functionality of your computer."
msgstr "Ayarları değiştirin ve bilgisayarınızın işleyişini özelleştirin."

#: ../contents/ui/SidePanelModels.qml
msgid "Devices and Printers"
msgstr "Aygıtlar ve Yazıcılar"

#: ../contents/ui/SidePanelModels.qml
msgid "View and manage devices, printers and print jobs."
msgstr "Aygıtları, yazıcıları ve yazdırma işlerini görüntüleyin ve yönetin."

#: ../contents/ui/SidePanelModels.qml
msgid "Default Programs"
msgstr "Öntanımlı Programlar"

#: ../contents/ui/SidePanelModels.qml
msgid "Choose default programs for web browsing, e-mail and other activities."
msgstr "Web'de gezinme, e-posta ve diğer etkinlikler için öntanımlı programları seçin."

#: ../contents/ui/SidePanelModels.qml
msgid "Help and Support"
msgstr "Yardım ve Destek"

#: ../contents/ui/SidePanelModels.qml
msgid "Find help topics, tutorials, troubleshooting and other support services."
msgstr "Yardım konularını, öğreticileri, sorun gidermeyi ve diğer destek hizmetlerini bulun."

#: ../contents/ui/SidePanelModels.qml
msgid "Run…"
msgstr "Çalıştır…"

#: ../contents/ui/SidePanelModels.qml
msgid "Open a program, folder, document or web site."
msgstr "Bir program, klasör, belge veya web sitesi açın."
