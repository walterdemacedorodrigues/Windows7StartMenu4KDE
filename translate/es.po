msgid "ClassicShell and OpenShell orb textures are supported. The image must stack the normal, hovered and pressed frames vertically."
msgstr "Se admiten las texturas de orbe de ClassicShell y OpenShell. La imagen debe apilar verticalmente los fotogramas normal, resaltado y pulsado."

#: ../contents/ui/OrbPicker.qml
msgctxt "@item:inmenu Open file chooser dialog"
msgid "Choose…"
msgstr "Elegir…"

#: ../contents/ui/OrbPicker.qml
msgctxt "@item:inmenu Reset to the bundled orb"
msgid "Reset"
msgstr "Restablecer"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "User Settings"
msgstr "Configuración del usuario"

#: ../contents/ui/parts/PersonalPortrait.qml
msgid "Click to open user account settings"
msgstr "Haga clic para abrir la configuración de la cuenta de usuario"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Restart"
msgstr "Reiniciar"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Turn Off Screen"
msgstr "Apagar la pantalla"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Lock Screen"
msgstr "Bloquear pantalla"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Sleep"
msgstr "Suspender"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Hibernate"
msgstr "Hibernar"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Log Out"
msgstr "Cerrar sesión"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Shutdown"
msgstr "Apagar"

#: ../contents/ui/parts/PowerButtons.qml
msgid "Closes all open programs, shuts down the system and turns off your computer."
msgstr "Cierra todos los programas abiertos, apaga el sistema y desconecta el equipo."

#: ../contents/ui/SidePanelModels.qml
msgid "Open your personal folder."
msgstr "Abre su carpeta personal."

#: ../contents/ui/SidePanelModels.qml
msgid "Documents"
msgstr "Documentos"

#: ../contents/ui/SidePanelModels.qml
msgid "Access letters, reports, notes and other kinds of documents."
msgstr "Acceda a cartas, informes, notas y otros tipos de documentos."

#: ../contents/ui/SidePanelModels.qml
msgid "Pictures"
msgstr "Imágenes"

#: ../contents/ui/SidePanelModels.qml
msgid "View and organize digital pictures."
msgstr "Vea y organice imágenes digitales."

#: ../contents/ui/SidePanelModels.qml
msgid "Music"
msgstr "Música"

#: ../contents/ui/SidePanelModels.qml
msgid "Play music and other audio files."
msgstr "Reproduzca música y otros archivos de audio."

#: ../contents/ui/SidePanelModels.qml
msgid "Videos"
msgstr "Vídeos"

#: ../contents/ui/SidePanelModels.qml
msgid "Watch home movies and other digital videos."
msgstr "Vea películas caseras y otros vídeos digitales."

#: ../contents/ui/SidePanelModels.qml
msgid "Downloads"
msgstr "Descargas"

#: ../contents/ui/SidePanelModels.qml
msgid "Find Internet downloads and links to favorite websites."
msgstr "Encuentre descargas de Internet y enlaces a sus sitios web favoritos."

#: ../contents/ui/SidePanelModels.qml
msgid "Games"
msgstr "Juegos"

#: ../contents/ui/SidePanelModels.qml
msgid "Play and manage games on your computer."
msgstr "Juegue y administre los juegos de su equipo."

#: ../contents/ui/SidePanelModels.qml
msgid "Recent Items"
msgstr "Elementos recientes"

#: ../contents/ui/SidePanelModels.qml
msgid "Open documents you worked on recently."
msgstr "Abra documentos en los que trabajó recientemente."

#: ../contents/ui/SidePanelModels.qml
msgid "Computer"
msgstr "Equipo"

#: ../contents/ui/SidePanelModels.qml
msgid "See the disk drives and other hardware connected to your computer."
msgstr "Vea las unidades de disco y demás hardware conectado a su equipo."

#: ../contents/ui/SidePanelModels.qml
msgid "Network"
msgstr "Red"

#: ../contents/ui/SidePanelModels.qml
msgid "Access the computers and devices that are on your network."
msgstr "Acceda a los equipos y dispositivos de su red."

#: ../contents/ui/SidePanelModels.qml
msgid "Control Panel"
msgstr "Panel de control"

#: ../contents/ui/SidePanelModels.qml
msgid "Change settings and customize the functionality of your computer."
msgstr "Cambie la configuración y personalice el funcionamiento de su equipo."

#: ../contents/ui/SidePanelModels.qml
msgid "Devices and Printers"
msgstr "Dispositivos e impresoras"

#: ../contents/ui/SidePanelModels.qml
msgid "View and manage devices, printers and print jobs."
msgstr "Vea y administre dispositivos, impresoras y trabajos de impresión."

#: ../contents/ui/SidePanelModels.qml
msgid "Default Programs"
msgstr "Programas predeterminados"

#: ../contents/ui/SidePanelModels.qml
msgid "Choose default programs for web browsing, e-mail and other activities."
msgstr "Elija los programas predeterminados para navegar por la web, el correo electrónico y otras actividades."

#: ../contents/ui/SidePanelModels.qml
msgid "Help and Support"
msgstr "Ayuda y soporte técnico"

#: ../contents/ui/SidePanelModels.qml
msgid "Find help topics, tutorials, troubleshooting and other support services."
msgstr "Encuentre temas de ayuda, tutoriales, solución de problemas y otros servicios de soporte."

#: ../contents/ui/SidePanelModels.qml
msgid "Run…"
msgstr "Ejecutar…"

#: ../contents/ui/SidePanelModels.qml
msgid "Open a program, folder, document or web site."
msgstr "Abra un programa, carpeta, documento o sitio web."
